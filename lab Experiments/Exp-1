from collections import deque

start = (1,2,3,4,0,6,7,5,8)
goal = (1,2,3,4,5,6,7,8,0)
q = deque([start])
seen = {start}

while q:
    s = q.popleft()
    print(s)
    if s == goal:
        break
    z = s.index(0)
    for n in [z-3,z+3,z-1,z+1]:
        if 0 <= n < 9 and not (
            abs(z-n)==1 and z//3 != n//3):
            t = list(s)
            t[z],t[n] = t[n],t[z]
            t = tuple(t)
            if t not in seen:
                seen.add(t)
                q.append(t)
