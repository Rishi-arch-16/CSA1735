
parent(john, mary).
parent(john, david).
parent(mary, sam).
parent(david, lisa).

male(john).
male(david).
male(sam).

female(mary).
female(lisa).

father(X, Y) :-
    parent(X, Y),
    male(X).

mother(X, Y) :-
    parent(X, Y),
    female(X).

sibling(X, Y) :-
    parent(Z, X),
    parent(Z, Y),
    X \= Y.
